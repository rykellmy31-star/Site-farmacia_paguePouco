# ============================================================
# FARMACIA PAGUE POUCO - variaveis de ambiente (SEGREDOS)
# Copie para .env e preencha. NUNCA publique o .env.
# Tudo que e dado de negocio (fretes, whatsapp, banners, textos)
#  e configurado pelo PAINEL, nao por aqui.
# ============================================================

# Servidor
PORT=3000
HOST=0.0.0.0
# Caminho dos dados persistentes (banco, uploads, logs, sessoes)
DATA_DIR=./data
# URL publica da loja (usada em links de e-mail, sitemap e retorno de pagamento)
PUBLIC_BASE_URL=http://localhost:3000
# true = modo desenvolvimento (mostra fila de e-mails no painel, erros detalhados)
DEV_MODE=true

# Seguranca: OBRIGATORIO trocar em producao.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=TROQUE_ESTE_VALOR_POR_UMA_CHAVE_ALEATORIA_LONGA

# ============================================================
# PAGAMENTOS
# ============================================================
# internal  = provedor interno de TESTES (nao move dinheiro real; usado ate voce
#             liberar credenciais). Padrao e seguro.
# mercadopago = usa a API real do Mercado Pago. Exige credenciais abaixo.
PAYMENT_PROVIDER=internal

# Credenciais do Mercado Pago (produção ou sandbox - obtidas no painel do MP).
# Deixe vazio para operar em modo interno de testes.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# true = nao cria cobrancas reais (recomendado ate a validacao final)
MP_SANDBOX=true
# Chave PIX da empresa (usada apenas para exibir o recebedor na tela de pagamento)
MP_PIX_KEY=

# ============================================================
# CONSULTA DE CEP (opcional)
# ============================================================
# O sistema identifica a UF do CEP OFFLINE (tabela de faixas dos Correios), sem custo.
# Se quiser tambem preencher cidade/bairro/logradouro automaticamente:
VIACEP_ENABLED=false
VIACEP_TIMEOUT_MS=3500

# ============================================================
# E-MAIL (opcional)
# ============================================================
# Sem SMTP configurado, os e-mails ficam na "fila de saida" do painel (modo DEV).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@paguepouco.com.br

# ============================================================
# UPLOADS
# ============================================================
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=67108864
# Otimizacao de imagem: requer o pacote opcional "sharp" instalado pelo responsavel tecnico.
# Se ausente, o sistema apenas valida e serve a imagem original (sem erro).
IMAGE_OPTIMIZE=false
